{
  "expo": {
    "name": "NodeCast",
    "slug": "nodecast-iphone",
    "version": "0.2.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nhshajib.nodecast",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Connect to your IPTV server on your home network.",
        "LSApplicationQueriesSchemes": [
          "vlc-x-callback",
          "infuse"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B9B4F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-video",
      "expo-dev-client",
      [
        "expo-libvlc-player",
        {
          "localNetworkPermission": "Connect to your IPTV server on your home network."
        }
      ]
    ],
    "backgroundColor": "#F5F5F8",
    "scheme": "nodecast",
    "extra": {
      "eas": {
        "projectId": "49ee7c99-08db-4b89-ad01-022961dcfd6c"
      }
    }
  }
}
