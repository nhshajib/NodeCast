{
  "expo": {
    "name": "NodeCast",
    "slug": "nodecast-iphone",
    "version": "0.6.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "601",
      "supportsTablet": true,
      "bundleIdentifier": "com.nhshajib.nodecast",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Connect to your IPTV server on your home network.",
        "LSApplicationQueriesSchemes": [
          "vlc-x-callback",
          "infuse"
        ],
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      },
      "requireFullScreen": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090124",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": false
        }
      ],
      "expo-dev-client",
      [
        "expo-libvlc-player",
        {
          "localNetworkPermission": "Connect to your IPTV server on your home network."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090124",
          "image": "./assets/brand/nodecast-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ]
    ],
    "backgroundColor": "#090124",
    "scheme": "nodecast",
    "extra": {
      "eas": {
        "projectId": "49ee7c99-08db-4b89-ad01-022961dcfd6c"
      }
    }
  }
}
