---
import {screenshotSize} from '../data/screenshots';
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import pages from '../data/pages.json';
import release from '../data/release';
import type {DownloadPlatform} from '../data/release';
import DownloadActions from '../components/DownloadActions.astro';
import DownloadDetails from '../components/DownloadDetails.astro';
import DirectDownloads from '../components/DirectDownloads.astro';
import {disclaimer,faqs} from '../data/site';
export function getStaticPaths(){return pages.map(page=>({params:{slug:page.path},props:{page}}));}
const {page}=Astro.props;
if(page.kind==='guide'&&!page.steps?.length)throw new Error('A guide requires steps: '+page.path);
if(page.kind==='article'&&!page.sections?.length)throw new Error('An article requires sections: '+page.path);
const platform=(page.platform ?? 'ios') as DownloadPlatform;
const searchTopics=[...pages.filter(p=>p.path.startsWith('guides/')||p.path.startsWith('install/')).map(p=>({title:p.title,description:p.intro,url:`/${p.path}/`})),...faqs.map(([title,description])=>({title,description,url:'/support/faq/'})),{title:'No sound',description:'Check device volume and audio tracks in the on-screen player settings. Try another channel or playback engine.',url:'/guides/fix-buffering/'},{title:'AirPlay and casting',description:'Compatible native playback on iOS supports AirPlay and picture-in-picture. Chromecast is not supported.',url:'/support/faq/'}];
---
<Layout title={page.title} description={page.description} path={`/${page.path}/`} faq={page.kind==='faq'||page.kind==='platform'} software={page.kind==='platform'||page.kind==='download-index'} downloadPlatform={page.kind==='platform'?platform:undefined}><section class:list={['page-hero','panel',page.kind==='platform'?'peach':'mint']}><p class="eyebrow">GlowTV · Your TV, beautifully lit.</p><h1>{page.h1}</h1><p class="intro">{page.intro}</p>{page.kind==='platform'&&<><DownloadActions platform={platform}/><div class:list={['download-stage',platform==='tv'&&'tv']}>{['guide','home','playlists'].map((screen,i)=><div class:list={['download-shot',i===1&&'center']}><img src={`/screenshots/${platform}-${screen}.webp`} alt={`GlowTV ${screen} on ${platform==='ios'?'iPhone':platform==='android'?'Android':'TV'}`} srcset={`/screenshots/${platform}-${screen}-small.webp 360w, /screenshots/${platform}-${screen}.webp ${screenshotSize(platform,screen).width}w`} sizes={platform==='tv'?'(max-width:600px) 30vw, 280px':'(max-width:600px) 155px, 220px'} width={screenshotSize(platform,screen).width} height={screenshotSize(platform,screen).height} fetchpriority={i===1?'high':'auto'} loading="eager"/></div>)}</div></>}</section>
{page.cards&&<section class="content"><div class="route-cards">{page.cards.map(([slug,title,description])=><a class="route-card" href={`/${page.kind==='download-index'?'download':page.kind==='guide-index'?'guides':'install'}/${slug}/`}><h2>{title} ↗</h2><p>{description}</p></a>)}</div><p>{disclaimer}</p></section>}
{page.kind==='download-index'&&<DirectDownloads/>}
{page.kind==='platform'&&<><DownloadDetails platform={platform}/><p class="gallery-preview-note">GlowTV design preview · Screenshots show the upcoming interface, not the older NodeCast download.</p><Gallery platform={platform}/><FAQ/></>}
{page.kind==='guide'&&<article class="content">{page.notice&&<p class="notice">{page.notice}</p>}{(page.steps||[]).map((step,i)=><section class="guide-step"><span class="number">STEP {String(i+1).padStart(2,'0')}</span><div><h2>{step.title}</h2><p>{step.text}</p><p class="step-result"><strong>Expected result:</strong> {step.result}</p><img class="step-illustration" src={`/illustrations/step-${(i%4)+1}.svg`} alt={`Illustration of step ${i+1}: ${step.title}`} width="360" height="160" loading="lazy"/></div></section>)}<h2>Next: add your playlist</h2><p><a href="/guides/add-m3u-playlist/">Add an M3U playlist or file</a> · <a href="/guides/xtream-codes-login/">Connect with Xtream Codes</a> · <a href="/guides/tv-guide-epg/">Load your TV guide</a></p><p>Need another hand? <a href="/support/">Get help with GlowTV</a>.</p><p class="disclaimer">{disclaimer}</p></article>}
{page.kind==='faq'&&<FAQ/>}
{page.kind==='support'&&<section class="content"><label class="search-label" for="help-search">Search FAQs and guides</label><input class="support-search" id="help-search" type="search" placeholder="Try playlist, buffering or no sound" aria-controls="help-results"/><p id="search-status" class="small" role="status" aria-live="polite"></p><ul id="help-results" class="search-results">{searchTopics.map(topic=><li data-help data-search={`${topic.title} ${topic.description}`.toLowerCase()}><a href={topic.url}>{topic.title}</a></li>)}</ul><h2>Report a problem</h2><p>Email <a href="mailto:support@glowtv.app">support@glowtv.app</a> or <a href="https://github.com/nhshajib/NodeCast/issues/new?template=problem.yml">open a GitHub issue</a>.</p><p>Include your app version from Settings → Version history, device model, OS version, playback engine, what you expected and what happened. Include reproducible steps and whether another channel works.</p><p class="notice">Remove passwords, usernames, full playlist URLs and tokens from screenshots and logs.</p><h2>Quick checks</h2><h3>The playlist will not load</h3><p>Check the exact URL and subscription status. HTTP 404 means the requested provider address was not found. Keep the query parameters in an M3U URL.</p><h3>The guide is empty</h3><p>Check the XMLTV feed, matching channel IDs and timezone. <a href="/guides/tv-guide-epg/">Follow the TV guide steps</a>.</p><h3>There is no sound</h3><p>Check device volume, the selected audio track and another channel. Try an available playback engine for an unsupported codec.</p><h3>Casting is unavailable</h3><p>AirPlay and picture-in-picture depend on native iOS playback and compatible streams. Built-in VLC has different capabilities. Chromecast is not implemented.</p></section>}
{page.kind==='article'&&<article class="content">{(page.sections||[]).map(([heading,text])=><section><h2>{heading}</h2><p>{text}</p></section>)}<p><a href="https://github.com/nhshajib/NodeCast">Read the source and license notices</a> · <a href="/support/">Contact support</a></p></article>}
{page.kind==='changelog'&&<article class="content"><p class="eyebrow">In development · GlowTV rebrand</p><h2>Your TV, beautifully lit.</h2><ul><li>New GlowTV display name and supplied launcher artwork.</li><li>App and website separated into independent projects.</li><li>Original demo scenes replace the old public sample library.</li><li>Platform guides, accessible galleries and provider help.</li><li>Existing playback engines, profiles and animation timing preserved.</li></ul><p>These are source changes, not a claim that a new compiled release has shipped.</p><a class="text-link" href="/changelog/rss.xml">Subscribe to the updates feed ↗</a><h2>Published releases</h2><p>Current public testing releases are listed below. GlowTV design changes above remain in development.</p><div class="release-links">{Object.entries(release.platforms).map(([edition,item])=>item&&<a href={item.source}>{edition==='ios'?'iPhone':edition==='tv'?'TV':'Android'} {item.version} release notes ↗</a>)}</div><a href="https://github.com/nhshajib/NodeCast/releases">View the complete project release history</a></article>}
<script>
const field=document.querySelector<HTMLInputElement>('#help-search');
field?.addEventListener('input',()=>{const query=field.value.trim().toLowerCase();let count=0;for(const item of document.querySelectorAll<HTMLElement>('[data-help]')){item.hidden=!item.dataset.search?.includes(query);if(!item.hidden)count++;}const status=document.querySelector('#search-status');if(status)status.textContent=`${count} helpful ${count===1?'result':'results'}`;});
</script>
</Layout>
