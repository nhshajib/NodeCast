---
import {screenshotSize} from '../data/screenshots';
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import pages from '../data/pages.json';
import release from '../data/release.json';
import {disclaimer,faqs} from '../data/site';
export function getStaticPaths(){return pages.map(page=>({params:{slug:page.path},props:{page}}));}
const {page}=Astro.props;
const platform=page.platform;
const assetName=platform==='tv'?'GlowTV-TV.apk':'GlowTV.apk';
const artifact=release.assets[assetName];
const guide=platform==='ios'?'iphone':platform==='tv'?'android-tv':'android';
const searchTopics=[...pages.filter(p=>p.path.startsWith('guides/')||p.path.startsWith('install/')).map(p=>({title:p.title,description:p.intro,url:`/${p.path}/`})),...faqs.map(([title,description])=>({title,description,url:'/support/faq/'})),{title:'No sound',description:'Check device volume and audio tracks in the on-screen player settings. Try another channel or playback engine.',url:'/guides/fix-buffering/'},{title:'AirPlay and casting',description:'Compatible native playback on iOS supports AirPlay and picture-in-picture. Chromecast is not supported.',url:'/support/faq/'}];
---
<Layout title={page.title} description={page.description} path={`/${page.path}/`} faq={page.kind==='faq'||page.kind==='platform'} software={page.kind==='platform'||page.kind==='download-index'}><section class:list={['page-hero','panel',page.kind==='platform'?'peach':'mint']}><p class="eyebrow">GlowTV · Your TV, beautifully lit.</p><h1>{page.h1}</h1><p class="intro">{page.intro}</p>{page.kind==='platform'&&<><div class="download-options">{platform==='ios'?<span class="availability">App Store · [APP_STORE_URL]</span>:<><span class="availability">Google Play · [PLAY_STORE_URL]</span>{artifact?<a class="button" href={`https://github.com/nhshajib/NodeCast/releases/latest/download/${assetName}`}>Download {platform==='tv'?'TV ':''}APK ↓</a>:<span class="availability">Official {platform==='tv'?'TV ':''}APK · release pending</span>}</>}{platform==='tv'&&<span class="availability">Amazon Appstore · [AMAZON_URL]</span>}</div><div class="platform-notes"><p>{platform==='tv'?'Android TV, Google TV and Fire TV share the TV edition. Apple TV is not yet supported; a tvOS project is still required.':'Store listings are not published yet. This preview does not link to an unavailable listing.'}</p>{platform==='tv'&&<p>Downloader: [DOWNLOADER_CODE] · Apple TV: [APP_STORE_URL]</p>}</div><div class:list={['download-stage',platform==='tv'&&'tv']}>{['guide','home','playlists'].map((screen,i)=><div class:list={['download-shot',i===1&&'center']}><img src={`/screenshots/${platform}-${screen}.webp`} alt={`GlowTV ${screen} on ${platform==='ios'?'iPhone':platform==='android'?'Android':'TV'}`} srcset={`/screenshots/${platform}-${screen}-small.webp 360w, /screenshots/${platform}-${screen}.webp 720w`} sizes={platform==='tv'?'(max-width:600px) 30vw, 280px':'(max-width:600px) 155px, 220px'} width={screenshotSize(platform,screen).width} height={screenshotSize(platform,screen).height} fetchpriority={i===1?'high':'auto'} loading="eager"/></div>)}</div></>}</section>
{page.cards&&<section class="content"><div class="route-cards">{page.cards.map(([slug,title,description])=><a class="route-card" href={`/${page.kind==='download-index'?'download':page.kind==='guide-index'?'guides':'install'}/${slug}/`}><h2>{title} ↗</h2><p>{description}</p></a>)}</div><p>{disclaimer}</p></section>}
{page.kind==='platform'&&<><section class="content"><h2>Release details</h2>{release.version&&artifact?<div class="release-grid"><div><span class="release-label">Version</span>{release.version}</div><div><span class="release-label">Published</span>{new Date(release.publishedAt).toLocaleDateString('en',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</div><div><span class="release-label">Download size</span>{(artifact.size/1048576).toFixed(1)} MB</div><div><span class="release-label">Minimum OS</span>{artifact.minimumOS}</div><div style="grid-column:1/-1"><span class="release-label">SHA-256</span><code>{artifact.sha256}</code></div></div>:<p class="notice">A verified GlowTV binary has not been published for this platform. Version, release date, file size, minimum OS and APK checksums appear automatically from release metadata when available. Earlier binaries are not relabeled as GlowTV downloads.</p>}<h2>What you will need</h2><p>{platform==='ios'?'An iPhone or iPad, your own playlist and a working network connection. A personally signed IPA needs a valid signing certificate; App Store availability is pending.':platform==='android'?'An Android phone, your own playlist and permission for your browser or file manager to install an official APK. Exact minimum OS requirements accompany the compiled release.':'An Android TV, Google TV or Fire TV device with a D-pad remote, your own playlist and a working connection. Exact minimum OS requirements accompany the TV APK.'}</p><h2>A brighter look</h2><p>The GlowTV redesign brings a calm iOS layout, dark Android surfaces and a dedicated TV rail. Existing playback, profiles and screen transitions stay familiar.</p><p><a class="text-link" href="/changelog/">Read development changes ↗</a></p><p><a class="text-link" href={`/install/${guide}/`}>Read the installation guide ↗</a></p>{platform==='tv'&&<p><a href="/install/fire-tv/">Install on Fire TV</a> · <a href="/install/apple-tv/">Apple TV status</a></p>}<p class="disclaimer">{disclaimer}</p></section><Gallery platform={platform}/><FAQ/></>}
{page.kind==='guide'&&<article class="content">{page.notice&&<p class="notice">{page.notice}</p>}{page.steps.map((step,i)=><section class="guide-step"><span class="number">STEP {String(i+1).padStart(2,'0')}</span><div><h2>{step.title}</h2><p>{step.text}</p><p class="step-result"><strong>Expected result:</strong> {step.result}</p><img class="step-illustration" src={`/illustrations/step-${(i%4)+1}.svg`} alt={`Illustration of step ${i+1}: ${step.title}`} width="360" height="160" loading="lazy"/></div></section>)}<h2>Next: add your playlist</h2><p><a href="/guides/add-m3u-playlist/">Add an M3U playlist or file</a> · <a href="/guides/xtream-codes-login/">Connect with Xtream Codes</a> · <a href="/guides/tv-guide-epg/">Load your TV guide</a></p><p>Need another hand? <a href="/support/">Get help with GlowTV</a>.</p><p class="disclaimer">{disclaimer}</p></article>}
{page.kind==='faq'&&<FAQ/>}
{page.kind==='support'&&<section class="content"><label class="search-label" for="help-search">Search FAQs and guides</label><input class="support-search" id="help-search" type="search" placeholder="Try playlist, buffering or no sound" aria-controls="help-results"/><p id="search-status" class="small" role="status" aria-live="polite"></p><ul id="help-results" class="search-results">{searchTopics.map(topic=><li data-help data-search={`${topic.title} ${topic.description}`.toLowerCase()}><a href={topic.url}>{topic.title}</a></li>)}</ul><h2>Report a problem</h2><p>Email <a href="mailto:support@glowtv.app">support@glowtv.app</a> or <a href="https://github.com/nhshajib/NodeCast/issues/new?template=problem.yml">open a GitHub issue</a>.</p><p>Include your app version from Settings → Version history, device model, OS version, playback engine, what you expected and what happened. Include reproducible steps and whether another channel works.</p><p class="notice">Remove passwords, usernames, full playlist URLs and tokens from screenshots and logs.</p><h2>Quick checks</h2><h3>The playlist will not load</h3><p>Check the exact URL and subscription status. HTTP 404 means the requested provider address was not found. Keep the query parameters in an M3U URL.</p><h3>The guide is empty</h3><p>Check the XMLTV feed, matching channel IDs and timezone. <a href="/guides/tv-guide-epg/">Follow the TV guide steps</a>.</p><h3>There is no sound</h3><p>Check device volume, the selected audio track and another channel. Try an available playback engine for an unsupported codec.</p><h3>Casting is unavailable</h3><p>AirPlay and picture-in-picture depend on native iOS playback and compatible streams. Built-in VLC has different capabilities. Chromecast is not implemented.</p></section>}
{page.kind==='article'&&<article class="content">{page.sections.map(([heading,text])=><section><h2>{heading}</h2><p>{text}</p></section>)}<p><a href="https://github.com/nhshajib/NodeCast">Read the source and license notices</a> · <a href="/support/">Contact support</a></p></article>}
{page.kind==='changelog'&&<article class="content"><p class="eyebrow">In development · GlowTV rebrand</p><h2>Your TV, beautifully lit.</h2><ul><li>New GlowTV display name and supplied launcher artwork.</li><li>App and website separated into independent projects.</li><li>Original demo scenes replace the old public sample library.</li><li>Platform guides, accessible galleries and provider help.</li><li>Existing playback engines, profiles and animation timing preserved.</li></ul><p>These are source changes, not a claim that a new compiled release has shipped.</p><a class="text-link" href="/changelog/rss.xml">Subscribe to the updates feed ↗</a><h2>Published releases</h2><p>{release.version?`Latest verified GlowTV release: ${release.version}.`:'No GlowTV-branded binary release is published yet.'}</p><a href="https://github.com/nhshajib/NodeCast/releases">View the complete project release history</a></article>}
<script>
const field=document.querySelector<HTMLInputElement>('#help-search');
field?.addEventListener('input',()=>{const query=field.value.trim().toLowerCase();let count=0;for(const item of document.querySelectorAll<HTMLElement>('[data-help]')){item.hidden=!item.dataset.search?.includes(query);if(!item.hidden)count++;}const status=document.querySelector('#search-status');if(status)status.textContent=`${count} helpful ${count===1?'result':'results'}`;});
</script>
</Layout>
