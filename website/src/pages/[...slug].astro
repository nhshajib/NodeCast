---
import {screenshotSize} from '../data/screenshots';
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import pages from '../data/pages.json';
import release from '../data/release';
import type {DownloadPlatform} from '../data/release';
import DownloadActions from '../components/DownloadActions.astro';
import DownloadDetails from '../components/DownloadDetails.astro';
import CommunityFeedback from '../components/CommunityFeedback.astro';
import DirectDownloads from '../components/DirectDownloads.astro';
import ChangelogView from '../components/ChangelogView.astro';
import {disclaimer,faqs} from '../data/site';
import Icon from '../components/Icon.astro';
export function getStaticPaths(){return pages.map(page=>({params:{slug:page.path},props:{page}}));}
const {page}=Astro.props;
if(page.kind==='guide'&&!page.steps?.length)throw new Error('A guide requires steps: '+page.path);
if(page.kind==='article'&&!page.sections?.length)throw new Error('An article requires sections: '+page.path);
const platform=(page.platform ?? 'ios') as DownloadPlatform;
// Guides, install pages and how-to articles link to related help so no page is left with only a menu link.
const guidePages=pages.filter(p=>p.path.startsWith('guides/'));
const at=Math.max(0,guidePages.findIndex(p=>p.path===page.path));
// The next guides in a ring, so every guide receives links from others.
const ring=[...guidePages.slice(at+1),...guidePages.slice(0,at+1)].filter(p=>p.path!==page.path);
const related=page.path.startsWith('install/')?guidePages.filter(p=>['guides/add-m3u-playlist','guides/xtream-codes-login','guides/m3u-vs-xtream-codes'].includes(p.path)):(page.path.startsWith('guides/')||page.kind==='faq'||page.kind==='support')?ring.slice(0,4):[];
const artifact=release.platforms[platform];
const searchTopics=[...pages.filter(p=>p.path.startsWith('guides/')||p.path.startsWith('install/')).map(p=>({title:p.title,description:p.intro,url:`/${p.path}/`})),...faqs.map(([title,description])=>({title,description,url:'/support/faq/'})),{title:'No sound',description:'Check device volume and audio tracks in the on-screen player settings. Try another channel or playback engine.',url:'/guides/fix-buffering/'},{title:'AirPlay and casting',description:'Compatible native playback on iOS supports AirPlay and picture-in-picture. Chromecast is not supported.',url:'/support/faq/'}];
---
<Layout title={page.title} description={page.description} path={`/${page.path}/`} faq={page.kind==='faq'||page.kind==='platform'} software={page.kind==='platform'||page.kind==='download-index'} downloadPlatform={page.kind==='platform'?platform:undefined} article={(page.kind==='guide'||(page.kind==='article'&&page.path.startsWith('guides/')))?{headline:page.title,dateModified:(page as {updated?:string}).updated,steps:(page.steps||[]).map(step=>step.title)}:null}><section class:list={['page-hero','night',page.kind==='platform'&&'has-stage']}><h1>{page.h1}</h1><p class="intro">{page.intro}</p>{page.kind==='platform'&&<><DownloadActions platform={platform}/><div class:list={['download-stage',platform==='tv'&&'tv']} tabindex="0" role="region" aria-label="App screenshots. On small screens, scroll sideways to see more.">{['guide','home','playlists'].map((screen,i)=><div class:list={['download-shot',i===1&&'center']}><img src={`/screenshots/${platform}-${screen}.webp`} alt={`GlowTV ${screen} on ${platform==='ios'?'iPhone':platform==='android'?'Android':'TV'}`} srcset={`/screenshots/${platform}-${screen}-small.webp 360w, /screenshots/${platform}-${screen}.webp ${screenshotSize(platform,screen).width}w`} sizes={platform==='tv'?'(max-width:600px) 30vw, 280px':'(max-width:600px) 155px, 220px'} width={screenshotSize(platform,screen).width} height={screenshotSize(platform,screen).height} fetchpriority={i===1?'high':'auto'} loading="eager"/></div>)}</div></>}</section>
{page.cards&&page.kind!=='download-index'&&<section class="content"><div class="route-cards">{page.cards.map(([slug,title,description])=><a class="route-card" href={`/${page.kind==='download-index'?'download':page.kind==='guide-index'?'guides':'install'}/${slug}/`}><h2>{title} <Icon name="arrow-right" size={20}/></h2><p>{description}</p></a>)}</div><p>{disclaimer}</p></section>}
{page.kind==='download-index'&&<><DirectDownloads/><section class="content" style="padding-top:0"><p class="disclaimer">{disclaimer}</p></section></>}
{page.kind==='platform'&&<><DownloadDetails platform={platform}/><p class="gallery-preview-note">{artifact?.legacy?'GlowTV design preview · Screenshots show the upcoming interface, not the older NodeCast download.':'GlowTV on your device · Real app screenshots using original demo content.'}</p><Gallery platform={platform}/><CommunityFeedback/><FAQ/></>}
{page.kind==='guide'&&<article class="content">{page.notice&&<p class="notice">{page.notice}</p>}{(page.steps||[]).map((step,i)=><section class="guide-step"><span class="number"><span class="sr-only">Step </span>{i+1}</span><div><h2>{step.title}</h2><p>{step.text}</p><p class="step-result"><strong>Expected result:</strong> {step.result}</p><img class="step-illustration" src={`/illustrations/step-${(i%4)+1}.svg`} alt="" width="360" height="160" loading="lazy"/></div></section>)}<p>Need another hand? <a href="/support/">Get help with GlowTV</a>.</p><p class="disclaimer">{disclaimer}</p></article>}
{related.length>0&&<section class="content related-guides" aria-labelledby="related-title"><h2 id="related-title">Related guides</h2><ul class="related-list">{related.map(r=><li><a href={`/${r.path}/`}>{r.title}</a></li>)}</ul></section>}
{page.kind==='faq'&&<FAQ/>}
{page.kind==='support'&&<section class="content"><label class="search-label" for="help-search">Search FAQs and guides</label><input class="support-search" id="help-search" type="search" placeholder="Try playlist, buffering or no sound" aria-controls="help-results"/><p id="search-status" class="small" role="status" aria-live="polite"></p><ul id="help-results" class="search-results">{searchTopics.map(topic=><li data-help data-search={`${topic.title} ${topic.description}`.toLowerCase()}><a href={topic.url}>{topic.title}</a></li>)}</ul><h2>Report a problem</h2><p>Email <a href="mailto:support@glowtv.app">support@glowtv.app</a> or <a href="https://github.com/nhshajib/NodeCast/issues/new?template=problem.yml">open a GitHub issue <Icon name="external" size={14}/></a>.</p><p>Include your app version from Settings → Version history, device model, OS version, playback engine, what you expected and what happened. Include reproducible steps and whether another channel works.</p><p class="notice">Remove passwords, usernames, full playlist URLs and tokens from screenshots and logs.</p><h2>Quick checks</h2><h3>The playlist will not load</h3><p>Check the exact URL and subscription status. HTTP 404 means the requested provider address was not found. Keep the query parameters in an M3U URL.</p><h3>The guide is empty</h3><p>Check the XMLTV feed, matching channel IDs and timezone. <a href="/guides/tv-guide-epg/">Follow the TV guide steps</a>.</p><h3>There is no sound</h3><p>Check device volume, the selected audio track and another channel. Try an available playback engine for an unsupported codec.</p><h3>Casting is unavailable</h3><p>AirPlay and picture-in-picture depend on native iOS playback and compatible streams. Built-in VLC has different capabilities. Chromecast is not implemented.</p></section>}
{page.kind==='article'&&<article class="content">{(page.sections||[]).map(([heading,text])=><section><h2>{heading}</h2><p>{text}</p></section>)}{!page.path.startsWith('guides/')&&<p><a href="https://github.com/nhshajib/NodeCast">Read the source and license notices <Icon name="external" size={14}/></a> · <a href="/support/">Contact support</a></p>}</article>}
{page.kind==='changelog'&&<ChangelogView/>}
<script>
const field=document.querySelector<HTMLInputElement>('#help-search');
field?.addEventListener('input',()=>{const query=field.value.trim().toLowerCase();let count=0;for(const item of document.querySelectorAll<HTMLElement>('[data-help]')){item.hidden=!item.dataset.search?.includes(query);if(!item.hidden)count++;}const status=document.querySelector('#search-status');if(status)status.textContent=`${count} helpful ${count===1?'result':'results'}`;});
</script>
</Layout>
