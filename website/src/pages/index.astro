---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import {features} from '../data/site';
const photos=[['television','A retro television with an empty screen'],['popcorn','Popcorn ready for a cozy TV night'],['headphones','Soft white headphones'],['sofa','A calm living room with a sofa'],['popcorn','A bowl of popcorn for movie night'],['headphones','Headphones for quiet listening']];
---
<Layout title="GlowTV: IPTV Player for iPhone, Android & TV" description="Watch your M3U and Xtream Codes playlists with a clean TV guide on iPhone, Android, Fire TV and Apple TV. Free download, no content sold or hosted." hero software faq><section class="hero panel"><div class="hero-copy"><p class="eyebrow"><span class="new">Meet GlowTV</span> Your TV, beautifully lit.</p><h1>TV the way it<br class="desktop-break"/> should be</h1><p class="hero-sub">The beautiful IPTV player for iPhone, Android and TV</p><a class="button" href="/download/" data-platform-download>Download <span aria-hidden="true">↗</span></a><div class="platform-links"><a href="/download/iphone/">iPhone &amp; iPad</a><span>·</span><a href="/download/android/">Android</a><span>·</span><a href="/download/tv/">TV</a></div></div><div class="hero-stage">{photos.map(([name,alt],i)=><div class={`photo-card photo-${i}`}><picture><source srcset={`/photos/${name}.webp`} type="image/webp"/><img src={`/photos/${name}.jpg`} alt={alt} width="480" height="600" loading={i>2?'lazy':'eager'} decoding="async"/></picture></div>)}<div class="phone"><span class="island" aria-hidden="true"></span><picture><source srcset="/screenshots/ios-home.webp" type="image/webp"/><img src="/screenshots/ios-home.png" alt="GlowTV iPhone home screen with an original demo playlist and continue watching" width="720" height="1560" fetchpriority="high"/></picture></div></div></section><section class="compatibility section" aria-label="Supported formats and playback features"><p class="eyebrow">Bring your playlist. Feel at home.</p><div><span>M3U / M3U8</span><span>Xtream Codes</span><span>XMLTV guide</span><span>AirPlay*</span><span>Picture-in-picture*</span></div><p class="small">*Compatible native playback on iOS. Stream and engine support varies.</p></section><section class="section panel mint" id="features"><p class="eyebrow">Less looking. More watching.</p><h2>Everything in its place.</h2><div class="feature-grid">{features.map(([title,body],i)=><article><span class="feature-number">0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section><section class="section"><p class="eyebrow">An easy evening starts here</p><h2>Three steps. Then play.</h2><div class="three-up">{[['Download','Choose the version made for your phone or television.','/download/'],['Add your playlist','Connect an M3U link, import a file or use your Xtream provider details.','/guides/add-m3u-playlist/'],['Start watching','Find your channel in the guide, save a favorite and settle in.','/guides/tv-guide-epg/']].map(([title,text,url],i)=><article class="step"><p class="eyebrow">Step 0{i+1}</p><h3>{title}</h3><p>{text}</p><a href={url}>Learn how <span aria-hidden="true">↗</span></a></article>)}</div></section><section class="section panel peach"><p class="eyebrow">One player. Your favorite screen.</p><h2>Make yourself comfortable.</h2><div class="three-up platforms">{[['iphone','iPhone & iPad','Light, calm and right at home on iOS.','ios'],['android','Android','A dark canvas that lets your library shine.','android'],['tv','The big screen','Built for Android TV, Google TV and Fire TV.','tv']].map(([slug,title,text,platform])=><a class="platform-card" href={`/download/${slug}/`}><div class:list={['mini-device',platform==='tv'&&'wide']}><img src={`/screenshots/${platform}-home.webp`} alt={`GlowTV home on ${title}`} width={platform==='tv'?1920:720} height={platform==='tv'?1080:1560} loading="lazy"/></div><h3>{title} <span aria-hidden="true">↗</span></h3><p>{text}</p></a>)}</div></section><Gallery/><FAQ/></Layout>
