---
import {screenshotSize} from '../data/screenshots';
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import {features, trustLine} from '../data/site';
const size = (platform: string) => screenshotSize(platform, 'home');
const steps = [
  ['Download GlowTV', 'Choose the version made for your phone or television.', '/download/', 'Choose your download'],
  ['Add your playlist', 'Paste an M3U link, import a file or sign in with your Xtream Codes details.', '/guides/add-m3u-playlist/', 'How to add a playlist'],
  ['Start watching', 'Find a channel in the guide, save a favorite and settle in.', '/guides/tv-guide-epg/', 'Set up the TV guide'],
];
const platforms = [
  ['iphone', 'ios', 'iPhone & iPad', 'Light, calm and right at home on iOS.', ''],
  ['android', 'android', 'Android', 'A dark canvas that lets your library shine.', 'dark'],
  ['tv', 'tv', 'Android TV & Fire TV', 'A big-screen layout built for the remote.', 'wide'],
];
---
<Layout title="GlowTV: IPTV Player for iPhone, Android & TV" description="Watch your M3U and Xtream Codes playlists with a clean TV guide on iPhone, Android and Fire TV. Free player download, no content sold or hosted." hero software faq>
<section class="hero night" aria-labelledby="hero-title">
  <div class="hero-copy">
    <img class="app-icon" src="/icon-192.png" alt="" width="192" height="192"/>
    <h1 id="hero-title">TV the way it should be</h1>
    <p class="hero-sub">A calm IPTV player for your own M3U and Xtream playlists, on iPhone, Android and the big screen.</p>
    <div class="hero-actions">
      <a class="button" href="/download/" data-platform-download><span data-label>Get GlowTV</span> <Icon name="arrow-right" size={18}/></a>
      <a class="button secondary" href="/download/">All devices</a>
    </div>
    <ul class="trust">{trustLine.map(item => <li><Icon name="check" size={16}/>{item}</li>)}</ul>
  </div>
  <div class="devices" tabindex="0" role="region" aria-label="GlowTV on iPhone, TV and Android. On small screens, scroll sideways to see each one.">
    <div class="device-phone ios"><picture><source type="image/webp" srcset="/screenshots/ios-home-small.webp 360w, /screenshots/ios-home-medium.webp 480w, /screenshots/ios-home.webp 720w" sizes="(max-width: 640px) 96px, 196px"/><img src="/screenshots/ios-home.png" alt="GlowTV home screen on iPhone" width={size('ios').width} height={size('ios').height}/></picture></div>
    <div class="device-tv"><picture><source type="image/webp" srcset="/screenshots/tv-home-small.webp 480w, /screenshots/tv-home.webp 960w" sizes="(max-width: 640px) 88vw, 680px"/><img src="/screenshots/tv-home.png" alt="GlowTV home screen on Android TV with a featured live channel" width={size('tv').width} height={size('tv').height} fetchpriority="high"/></picture></div>
    <div class="device-phone android"><picture><source type="image/webp" srcset="/screenshots/android-home-small.webp 360w, /screenshots/android-home.webp 720w" sizes="(max-width: 640px) 96px, 196px"/><img src="/screenshots/android-home.png" alt="GlowTV home screen on an Android phone" width={size('android').width} height={size('android').height}/></picture></div>
  </div>
</section>

<section class="formats" aria-labelledby="formats-title">
  <div class="formats-inner">
    <h2 id="formats-title">Works with</h2>
    <ul><li>M3U and M3U8</li><li>Xtream Codes</li><li>XMLTV guide</li><li>Catch-up</li><li>AirPlay and picture-in-picture on iPhone*</li></ul>
    <p class="small">*Native iOS playback with compatible streams. Stream and engine support varies.</p>
  </div>
</section>

<section class="section" id="features" aria-labelledby="features-title">
  <div class="section-head"><h2 id="features-title">Everything in its place</h2><p>Less time looking, more time watching. GlowTV keeps your channels, guide and library tidy on every screen.</p></div>
  <div class="feature-grid">{features.map(([icon, title, body]) => <article class="feature-card"><Icon name={icon} size={32}/><h3>{title}</h3><p>{body}</p></article>)}</div>
</section>

<section class="section" aria-labelledby="steps-title">
  <div class="section-head"><h2 id="steps-title">Three steps, then play</h2></div>
  <ol class="steps">{steps.map(([title, text, url, link], i) => <li class="step"><span class="step-number" aria-hidden="true">{i + 1}</span><h3>{title}</h3><p>{text}</p><a class="text-link" href={url}>{link} <Icon name="arrow-right" size={16}/></a></li>)}</ol>
</section>

<section class="section" aria-labelledby="platforms-title">
  <div class="section-head"><h2 id="platforms-title">One player for every screen</h2></div>
  <div class="platform-grid">{platforms.map(([slug, platform, title, text, look]) => <a class="platform-card" href={`/download/${slug}/`}><div class:list={['mini-device', look]}><img src={`/screenshots/${platform}-home.webp`} alt="" width={size(platform).width} height={size(platform).height} loading="lazy" decoding="async"/></div><h3>{title}</h3><p>{text}</p><span class="more">Get it for {title} <Icon name="arrow-right" size={16}/></span></a>)}</div>
</section>

<Gallery tabs/>
<FAQ/>
</Layout>
