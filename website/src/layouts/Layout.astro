---
import '../styles/global.css';
import { origin, disclaimer, faqs } from '../data/site';
import release from '../data/release.json';
const { title, description, path = '/', faq = false, software = false, hero = false } = Astro.props;
const canonical = new URL(path, origin).href;
const crumbs = path.split('/').filter(Boolean);
const image = origin + (path.startsWith('/download/') && crumbs.length > 1 ? `/og-${crumbs[1]}.png` : '/og-image-1200x630.png');
const schemas: object[] = [
 { '@context':'https://schema.org','@type':'Organization', '@id':origin+'/#organization', name:'GlowTV',url:origin,logo:origin+'/icon-512.png',email:'support@glowtv.app' },
 { '@context':'https://schema.org','@type':'WebSite', name:'GlowTV',url:origin,inLanguage:'en',publisher:{'@id':origin+'/#organization'} },
];
if (crumbs.length) schemas.push({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:'Home',item:origin+'/'},...crumbs.map((c:string,i:number)=>({name:c.replaceAll('-',' '),item:origin+'/'+crumbs.slice(0,i+1).join('/')+'/'}))].map((c,i)=>({'@type':'ListItem',position:i+1,...c}))});
if (software) schemas.push({'@context':'https://schema.org','@type':'SoftwareApplication',name:'GlowTV',applicationCategory:'MultimediaApplication',operatingSystem:'iOS, Android, Android TV, Fire OS',url:canonical,downloadUrl:origin+'/download/',screenshot:origin+'/screenshots/ios-home.webp',...(release.version?{softwareVersion:release.version}:{}),offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}});
if (faq) schemas.push({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))});
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="google-site-verification" content="[GSC_TOKEN]"/><link rel="icon" href="/favicon.ico" sizes="48x48"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/><meta name="theme-color" content="#0D4029"/><link rel="preload" href="/fonts/Inter-800.woff2" as="font" type="font/woff2" crossorigin/><meta property="og:type" content="website"/><meta property="og:site_name" content="GlowTV"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><link rel="alternate" type="application/rss+xml" title="GlowTV updates" href="/changelog/rss.xml"/>{hero && <link rel="preload" as="image" href="/screenshots/ios-home.webp"/>}{schemas.map(schema=><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}/>)}<!-- Analytics disabled. Configure [ANALYTICS_DOMAIN] and [ANALYTICS_SCRIPT_URL] after choosing a privacy-friendly service. --></head><body><a class="skip" href="#main">Skip to content</a><header class="nav"><a class="brand" href="/" aria-label="GlowTV home"><img src="/logo.svg" alt="GlowTV" width="156" height="48"/></a><nav aria-label="Main navigation"><a href="/#features">Features</a><a href="/download/">Download</a><a href="/install/">Install</a><a href="/support/">Support</a></nav><a class="button nav-download" href="/download/">Download <span aria-hidden="true">↗</span></a></header><main id="main">{path!=='/' && <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a>{crumbs.map((c:string,i:number)=><><span aria-hidden="true">/</span>{i===crumbs.length-1?<span aria-current="page">{c.replaceAll('-',' ')}</span>:<a href={'/'+crumbs.slice(0,i+1).join('/')+'/'}>{c.replaceAll('-',' ')}</a>}</>)}</nav>}<slot/></main><section class="final panel mint"><p class="eyebrow">Your playlist. A better place to play.</p><h2>Your TV, beautifully lit.</h2><a class="button" href="/download/">Find your version <span aria-hidden="true">↗</span></a></section><footer><a class="brand" href="/" aria-label="GlowTV home"><img src="/logo.svg" alt="GlowTV" width="156" height="48" loading="lazy"/></a><nav aria-label="Footer"><a href="/download/">Download</a><a href="/install/">Install</a><a href="/support/">Support</a><a href="/changelog/">Changelog</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/legal/">Legal and copyright</a><a href="https://github.com/nhshajib/NodeCast">Source code</a></nav><p class="disclaimer">{disclaimer}</p><p class="small">© {new Date().getFullYear()} GlowTV. Open source under GPL-3.0-only.</p></footer><script>
const ua=navigator.userAgent;
for(const link of document.querySelectorAll<HTMLAnchorElement>('[data-platform-download]'))link.href=/TV|AFT|BRAVIA|SHIELD/i.test(ua)?'/download/tv/':/Android/i.test(ua)?'/download/android/':/iPhone|iPad|iPod/i.test(ua)?'/download/iphone/':'/download/';
</script></body></html>
