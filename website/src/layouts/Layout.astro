---
import '../styles/global.css';
import { origin, disclaimer, faqs, crumbName, searchConsoleToken } from '../data/site';
import Icon from '../components/Icon.astro';
import release from '../data/release';
import type {DownloadPlatform} from '../data/release';
const { title, description, path = '/', faq = false, software = false, hero = false } = Astro.props;
const download=Astro.props.downloadPlatform?release.platforms[Astro.props.downloadPlatform as DownloadPlatform]:null;
const canonical = new URL(path, origin).href;
const crumbs = path.split('/').filter(Boolean);
// Phone layout: an iOS-style back button to the parent page replaces the breadcrumb trail.
const parentHref = crumbs.length > 1 ? '/' + crumbs.slice(0, -1).join('/') + '/' : '/';
const parentName = crumbs.length > 1 ? crumbName(crumbs[crumbs.length - 2]) : 'Home';
const section = path === '/' ? 'home' : path.startsWith('/download/') ? 'download' : path.startsWith('/install/') ? 'install' : 'help';
const image = origin + (path.startsWith('/download/') && crumbs.length > 1 ? `/og-${crumbs[1]}.png` : '/og-image-1200x630.png');
const schemas: object[] = [
 { '@context':'https://schema.org','@type':'Organization', '@id':origin+'/#organization', name:'GlowTV',url:origin,logo:origin+'/icon-512.png',email:'support@glowtv.app' },
 { '@context':'https://schema.org','@type':'WebSite', name:'GlowTV',url:origin,inLanguage:'en',publisher:{'@id':origin+'/#organization'} },
];
if (crumbs.length) schemas.push({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:'Home',item:origin+'/'},...crumbs.map((c:string,i:number)=>({name:crumbName(c),item:c==='404.html'?canonical:origin+'/'+crumbs.slice(0,i+1).join('/')+'/'}))].map((c,i)=>({'@type':'ListItem',position:i+1,...c}))});
if (software) schemas.push({'@context':'https://schema.org','@type':'SoftwareApplication',name:download?.legacy?'NodeCast':'GlowTV',applicationCategory:'MultimediaApplication',operatingSystem:'iOS, Android, Android TV, Fire OS',url:canonical,downloadUrl:download?.url||origin+'/download/',...(!download?.legacy?{screenshot:origin+'/screenshots/ios-home.webp'}:{}),...(download?{softwareVersion:download.version}:{}),offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}});
if (faq) schemas.push({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))});
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{searchConsoleToken && <meta name="google-site-verification" content={searchConsoleToken}/>}<link rel="icon" href="/favicon.ico" sizes="48x48"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/><meta name="theme-color" content="#0A0E0C"/><link rel="preload" href="/fonts/Inter-800.woff2" as="font" type="font/woff2" crossorigin/><meta property="og:type" content="website"/><meta property="og:site_name" content="GlowTV"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><link rel="alternate" type="application/rss+xml" title="GlowTV updates" href="/changelog/rss.xml"/>{hero && <link rel="preload" as="image" href="/screenshots/tv-home.webp" imagesrcset="/screenshots/tv-home-small.webp 480w, /screenshots/tv-home.webp 960w" imagesizes="(max-width: 640px) 88vw, 680px" fetchpriority="high"/>}{schemas.map(schema=><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}/>)}<!-- Analytics disabled. Configure [ANALYTICS_DOMAIN] and [ANALYTICS_SCRIPT_URL] after choosing a privacy-friendly service. --></head><body><a class="skip" href="#main">Skip to content</a>
<div class="night top">
 <header class="nav">{path!=='/' && <a class="ios-back" href={parentHref}><Icon name="chevron-left" size={24}/><span>{parentName}</span></a>}<a class:list={['brand', path!=='/' && 'brand-inner']} href="/" aria-label="GlowTV home"><img class="logo-on-dark" src="/logo-dark.svg" alt="GlowTV" width="156" height="47"/><img class="logo-on-light" src="/logo.svg" alt="" width="156" height="47"/></a><nav aria-label="Main navigation"><a href="/#features">Features</a><a href="/download/" aria-current={path.startsWith('/download/')?'page':undefined}>Download</a><a href="/install/" aria-current={path.startsWith('/install/')?'page':undefined}>Install</a><a href="/support/" aria-current={path.startsWith('/support/')||path.startsWith('/guides/')?'page':undefined}>Support</a></nav><a class="button nav-download" href="/download/" data-platform-download>Get GlowTV <Icon name="arrow-right" size={18}/></a></header>
 {path!=='/' && <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a>{crumbs.map((c:string,i:number)=><><span aria-hidden="true">/</span>{i===crumbs.length-1?<span aria-current="page">{crumbName(c)}</span>:<a href={'/'+crumbs.slice(0,i+1).join('/')+'/'}>{crumbName(c)}</a>}</>)}</nav>}
</div>
<main id="main"><slot/></main>
<section class="final night"><div class="final-inner"><h2>Your TV, beautifully lit.</h2><p>Free on iPhone, Android and the big screen. Bring your own playlist.</p><a class="button" href="/download/" data-platform-download>Get GlowTV <Icon name="arrow-right" size={18}/></a></div></section>
<nav class="tabbar" aria-label="Sections"><a href="/" aria-current={section==='home'?'page':undefined}><Icon name="home" size={26}/><span>Home</span></a><a href="/download/" aria-current={section==='download'?'page':undefined}><Icon name="download" size={26}/><span>Download</span></a><a href="/install/" aria-current={section==='install'?'page':undefined}><Icon name="install" size={26}/><span>Install</span></a><a href="/support/" aria-current={section==='help'?'page':undefined}><Icon name="help" size={26}/><span>Help</span></a></nav>
<footer><div class="footer-inner"><div class="footer-brand"><a class="brand" href="/" aria-label="GlowTV home"><img src="/logo.svg" alt="GlowTV" width="156" height="47"/></a><p class="disclaimer">{disclaimer}</p><p class="small">© {new Date().getFullYear()} GlowTV. Open source under GPL-3.0-only.</p></div><nav aria-label="Footer"><div><h2>Get GlowTV</h2><a href="/download/iphone/">iPhone &amp; iPad</a><a href="/download/android/">Android</a><a href="/download/tv/">Android TV &amp; Fire TV</a><a href="/changelog/">Changelog</a></div><div><h2>Help</h2><a href="/install/">Install guides</a><a href="/guides/">How-to guides</a><a href="/support/">Support</a><a href="/support/faq/">FAQ</a></div><div><h2>About</h2><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/legal/">Legal and copyright</a><a href="https://github.com/nhshajib/NodeCast">Source code <Icon name="external" size={15}/></a></div></nav></div></footer><script>
const ua=navigator.userAgent;
const target=/TV|AFT|BRAVIA|SHIELD/i.test(ua)?['/download/tv/','TV']:/Android/i.test(ua)?['/download/android/','Android']:/iPhone|iPad|iPod/i.test(ua)?['/download/iphone/','iPhone']:null;
for(const link of document.querySelectorAll<HTMLAnchorElement>('[data-platform-download]')){link.href=target?target[0]:'/download/';if(target)link.setAttribute('aria-label',`Get GlowTV for ${target[1]}`);}
</script></body></html>
