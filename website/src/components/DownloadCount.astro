---
import type {DownloadRelease} from '../data/release';
import {totalDownloads} from '../lib/download-counts.mjs';
import otherDownloads from '../data/other-downloads.json';
import Icon from './Icon.astro';
const {item,checkedAt,platform}=Astro.props as {item:DownloadRelease;checkedAt:string;platform:'ios'|'android'|'tv'};
const other=Number.isSafeInteger((otherDownloads as Record<string,unknown>)[platform])?(otherDownloads as Record<string,number>)[platform]:0;
// Fixed starting point from other sites, plus every earlier GitHub version.
const previous=(Number.isSafeInteger(item.previousDownloadCount)?item.previousDownloadCount as number:0)+other;
const count=totalDownloads(item.downloadCount,previous);
const date=new Date(checkedAt);
---
<div class="download-activity" data-download-count data-asset-id={item.assetId} data-asset-url={item.url} data-previous={previous}>
 <p class="download-activity-value"><Icon name="download" size={24}/><strong data-count-value aria-live="polite" aria-atomic="true">{count===null?'Download count unavailable':`${count.toLocaleString('en')} ${count===1?'download':'downloads'}`}</strong><span>{other?'all versions, GitHub and other sites':'on GitHub · all versions'}</span></p>
 <p class="download-activity-note">{other?`Includes ${other.toLocaleString('en')} downloads from other sites before GitHub; GitHub downloads update live. `:''}File downloads, not unique users or installs. <time data-count-date datetime={checkedAt}>Checked {Number.isNaN(date.valueOf())?'at build time':date.toLocaleDateString('en',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'})}.</time></p>
</div>
<script>
 import {assetDownloadCount,cachedDownloadCount} from '../lib/download-counts.mjs';
 for(const element of document.querySelectorAll<HTMLElement>('[data-download-count]')){
  const id=Number(element.dataset.assetId),url=element.dataset.assetUrl,previous=Number(element.dataset.previous)||0;
  if(!Number.isSafeInteger(id)||id<=0||!url)continue;
  const key=`glowtv.github-downloads.v1:${id}`;
  const show=(count:number,checkedAt:number)=>{
   const value=element.querySelector('[data-count-value]'),time=element.querySelector('time');
   const total=count+previous;const label=`${total.toLocaleString('en')} ${total===1?'download':'downloads'}`;
   if(value&&value.textContent!==label)value.textContent=label;
   if(time){const date=new Date(checkedAt);time.dateTime=date.toISOString();time.textContent=`Checked ${date.toLocaleDateString('en',{day:'numeric',month:'short',year:'numeric'})}.`;}
  };
  let cached:null|{url:string;count:number;checkedAt:number}=null;
  try{cached=JSON.parse(sessionStorage.getItem(key)||'null');}catch{/* Storage can be disabled. The server-rendered count still works. */}
  const saved=cachedDownloadCount(cached,url,Date.now());
  if(saved!==null&&cached){show(saved,cached.checkedAt);continue;}
  const controller=new AbortController(),timeout=setTimeout(()=>controller.abort(),5000);
  void fetch(`https://api.github.com/repos/nhshajib/NodeCast/releases/assets/${id}`,{headers:{Accept:'application/vnd.github+json'},credentials:'omit',referrerPolicy:'no-referrer',signal:controller.signal})
   .then(async response=>{
    if(!response.ok)return;
    const count=assetDownloadCount(await response.json(),url,id);if(count===null)return;
    const checkedAt=Date.now();show(count,checkedAt);
    try{sessionStorage.setItem(key,JSON.stringify({url,count,checkedAt}));}catch{/* Optional cache; never replace unavailable data with a made-up count. */}
   }).catch(()=>{/* Offline, blocked or rate-limited: retain the dated build snapshot. */}).finally(()=>clearTimeout(timeout));
 }
</script>
<style>
 .download-activity{margin:24px auto 0;padding:24px;max-width:680px;min-width:0;text-align:center;background:var(--night-2);border:1px solid var(--night-line);border-radius:16px}
 .download-activity-value{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:8px 12px;margin:0 auto;color:var(--on-night-muted);font-size:14px;line-height:1.5}
 .download-activity-value strong{color:var(--on-night);font-size:32px;line-height:1.2;letter-spacing:-.6px;font-weight:600;font-variant-numeric:tabular-nums;overflow-wrap:anywhere;min-width:0}
 .download-activity-value>span{flex-basis:100%;font-weight:600}
 .download-activity-note{font-size:12px;line-height:1.6;margin:12px auto 0;color:var(--on-night-muted);overflow-wrap:anywhere}
 @media(max-width:640px){
  .download-activity{margin:16px 0 0;padding:20px;text-align:left;background:var(--surface);border-color:var(--line)}
  .download-activity-value{justify-content:flex-start;color:var(--ios-secondary,var(--muted));font-size:14px}
  .download-activity-value strong{color:var(--ios-label,var(--ink));font-size:28px}
  .download-activity-note{margin-left:0;color:var(--ios-secondary,var(--muted))}
 }
</style>
