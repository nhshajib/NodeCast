---
import release from '../data/release';
import type {DownloadPlatform} from '../data/release';
import {versionHighlights} from '../data/downloads';
import Icon from './Icon.astro';
const names={ios:'iPhone and iPad',android:'Android phone and tablet',tv:'Android TV and Fire TV'};
const editions=Object.entries(release.platforms) as [DownloadPlatform,typeof release.platforms.ios][];
---
<article class="content">
 <p class="eyebrow">Published releases</p>
 <h2>Latest changes by edition</h2>
 <p>Each edition links to its published release and the exact files available to download.</p>
 {editions.map(([edition,item])=>item&&!item.legacy&&<section>
  <h3>{names[edition]} · {item.version}</h3>
  <ul>{versionHighlights(edition,item.version).map(change=><li>{change}</li>)}</ul>
  <a class="text-link" href={item.source}>{names[edition]} {item.version} release notes <Icon name="external" size={15}/></a>
 </section>)}
 <p><a class="text-link" href="/changelog/rss.xml">Subscribe to the updates feed (RSS)</a></p>
 <a href="https://github.com/nhshajib/NodeCast/releases">View the complete project release history <Icon name="external" size={15}/></a>
</article>
