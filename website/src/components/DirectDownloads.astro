---
import release from '../data/release';
import type {DownloadPlatform} from '../data/release';
import {screenshotSize} from '../data/screenshots';
import Icon from './Icon.astro';
const editions:[DownloadPlatform,string,string,string][]=[['ios','iPhone & iPad','IPA',''],['android','Android phone','APK','dark'],['tv','Android TV & Fire TV','TV APK','wide']];
---
<section class="content download-content" aria-labelledby="direct-downloads"><h2 id="direct-downloads">Choose your device</h2><p>Each edition has its own version, file size and checksum. Testing releases are labelled.</p><div class="direct-download-grid">{editions.map(([platform,title,format,look])=>{const item=release.platforms[platform];const page=`/download/${platform==='ios'?'iphone':platform}/`;const size=screenshotSize(platform,'home');return <article class="direct-download-card"><div class:list={['mini-device',look]}><img src={`/screenshots/${platform}-home.webp`} alt="" width={size.width} height={size.height} loading="lazy" decoding="async"/></div><h3>{title}</h3>{item?<><p class="meta">Version {item.version} · {(item.size/1048576).toFixed(0)} MB · {item.prerelease?'Testing release':'Stable release'}</p><a class="button" href={item.url}>Download {format} <Icon name="arrow-down" size={18}/></a><a class="more" href={page}>Features, checksum and release notes <Icon name="arrow-right" size={16}/></a></>:<><p class="meta">Download not published yet.</p><a class="more" href={page}>About this edition <Icon name="arrow-right" size={16}/></a></>}</article>})}</div></section>
