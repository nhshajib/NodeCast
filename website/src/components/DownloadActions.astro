---
import release from '../data/release';
import type {DownloadPlatform} from '../data/release';
import {stores} from '../data/site';
import Icon from './Icon.astro';
const {platform}=Astro.props as {platform:DownloadPlatform};
const item=release.platforms[platform];
const format=platform==='ios'?'IPA':platform==='tv'?'TV APK':'APK';
const storeLinks:[string,string][]=platform==='ios'?[['the App Store',stores.appStore]]:platform==='tv'?[['Google Play',stores.playStore],['Amazon Appstore',stores.amazonAppstore]]:[['Google Play',stores.playStore]];
const listed=storeLinks.filter(([,url])=>url);
const storeNames=storeLinks.map(([name])=>name).join(' or ');
---
<div class="download-options">
 {item?<a class="button" href={item.url}>Download {format} · {item.version} <Icon name="arrow-down" size={18}/></a>:<span class="availability">Public download not available yet</span>}
 <a class="download-guide-link" href={`/install/${platform==='ios'?'iphone':platform==='tv'?'android-tv':'android'}/`}>How to install <Icon name="arrow-right" size={16}/></a>
</div>
<div class="platform-notes">
 {item?.legacy&&<p class="download-notice">The available {item.version} file still uses the <strong>NodeCast</strong> name. The GlowTV screenshots show the upcoming redesign; it is not included in this download.</p>}
 <p>{item?`${item.prerelease?'Public testing release':'Published release'} from GitHub. `:''}{platform==='ios'?'Unsigned IPA: sign it with your own Apple account before installing. Free Apple signing usually needs renewal every seven days.':platform==='tv'?'Choose the TV APK for Android TV, Google TV and Fire TV. Use the phone APK on touch devices. Apple TV is not supported yet.':'Standalone Android APK. Allow installation for your browser or file manager when prompted, then install over the existing app to keep your profiles.'}</p>
 <p class="store-line">{listed.length?listed.map(([name,url],i)=><>{i>0&&' · '}<a href={url}>Get it on {name.replace(/^the /,'')} <Icon name="external" size={14}/></a></>):`GlowTV isn’t in ${storeNames} yet. Download it directly from GitHub above.`}{platform==='tv'&&stores.downloaderCode&&` Downloader code: ${stores.downloaderCode}.`}</p>
</div>
