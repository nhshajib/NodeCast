---
import {screenshotSize} from '../data/screenshots';
import {screens,screenLabel,platformLabel} from '../data/site';
const {platform='ios',id='screenshots',title='A little look around'}=Astro.props;
---
<section class="section gallery-section" aria-labelledby={id}><div class="section-heading"><div><p class="eyebrow">Made for {platformLabel[platform]}</p><h2 id={id}>{title}</h2></div><p>Swipe, scroll or use the arrow keys.</p></div><div class:list={['gallery',platform==='tv'&&'tv-gallery']} tabindex="0" role="region" aria-label={`${platformLabel[platform]} screenshot gallery`}>{screens.map(screen=><figure><a href={`/screenshots/${platform}-${screen}.png`} aria-label={`Open full screenshot: ${screenLabel[screen]} on ${platformLabel[platform]}`}><picture><source type="image/webp" srcset={`/screenshots/${platform}-${screen}-small.webp 360w, /screenshots/${platform}-${screen}.webp 720w`} sizes={platform==='tv'?'(max-width: 600px) 85vw, 600px':'(max-width: 600px) 72vw, 260px'}/><img src={`/screenshots/${platform}-${screen}.png`} alt={`GlowTV ${screenLabel[screen].toLowerCase()} on ${platformLabel[platform]}, using original demo content`} width={screenshotSize(platform,screen).width} height={screenshotSize(platform,screen).height} style={`aspect-ratio:${screenshotSize(platform,screen).width}/${screenshotSize(platform,screen).height}`} loading="lazy" decoding="async"/></picture></a><figcaption>{screenLabel[screen]}</figcaption></figure>)}</div></section>
