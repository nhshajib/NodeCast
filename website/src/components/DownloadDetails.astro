---
import release from '../data/release';
import type {DownloadPlatform} from '../data/release';
import {editionFeatures,editionFolders,versionHighlights} from '../data/downloads';
import {disclaimer} from '../data/site';
import Icon from './Icon.astro';
const {platform}=Astro.props as {platform:DownloadPlatform};
const item=release.platforms[platform];
const folder=editionFolders[platform];
const guide=platform==='ios'?'iphone':platform==='tv'?'android-tv':'android';
---
<section class="content download-content">
 <h2>Everything you need to settle in</h2>
 <div class="download-features">{editionFeatures(platform,item?.version||'0').map(([title,text])=><article><h3>{title}</h3><p>{text}</p></article>)}</div>
 <section class="release-panel" aria-labelledby="release-details"><p class="eyebrow">Know what you are installing</p><h2 id="release-details">Version and download details</h2>
 {item?<><dl class="release-grid"><div><dt class="release-label">Version</dt><dd>{item.version} · {item.prerelease?'Testing release':'Stable release'}</dd></div><div><dt class="release-label">Published</dt><dd>{new Date(item.publishedAt).toLocaleDateString('en',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</dd></div><div><dt class="release-label">Download size</dt><dd>{(item.size/1048576).toFixed(1)} MiB ({item.size.toLocaleString('en')} bytes)</dd></div><div><dt class="release-label">Minimum OS</dt><dd>{item.minimumOS||'Not listed in the published release'}</dd></div><div class="release-wide"><dt class="release-label">File</dt><dd><code>{item.file}</code></dd></div><div class="release-wide"><dt class="release-label">SHA-256</dt><dd><code>{item.sha256}</code></dd></div></dl><div class="release-links"><a href={item.url}>Direct GitHub download <Icon name="arrow-down" size={16}/></a>{item.checksumUrl&&<a href={item.checksumUrl}>Checksum file</a>}<a href={item.source}>GitHub release page <Icon name="external" size={15}/></a></div></>:<p>No published download is available for this edition yet.</p>}
 </section>
 <section class="release-notes"><p class="eyebrow">Version history</p><h2>{item?`What’s new in ${item.version}`:'Published release notes'}</h2>{item&&<ul>{versionHighlights(platform,item.version).map(note=><li>{note}</li>)}</ul>}<div class="release-links">{item&&<a href={item.source}>Full notes for {item.version} <Icon name="external" size={15}/></a>}<a href={`https://github.com/nhshajib/NodeCast/blob/main/apps/player/${folder}/CHANGELOG.md`}>Earlier {platform==='ios'?'iPhone':platform==='tv'?'TV':'Android'} versions <Icon name="external" size={15}/></a></div></section>
 <h2>Install, then add your playlist</h2><p><a href={`/install/${guide}/`}>Follow the installation guide</a>, then connect your own <a href="/guides/add-m3u-playlist/">M3U playlist</a> or <a href="/guides/xtream-codes-login/">Xtream Codes account</a>.</p>
 {platform==='tv'&&<p><a href="/install/fire-tv/">Fire TV installation</a> · <a href="/install/apple-tv/">Apple TV availability</a></p>}
 <p><a href="/changelog/">{item?.legacy?'Explore the upcoming GlowTV design and development changelog':'Read the complete GlowTV changelog'}</a></p><p class="disclaimer">{disclaimer}</p>
</section>
