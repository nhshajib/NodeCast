---
import feedback from '../data/feedback.json';
import Icon from './Icon.astro';
// Quotes are shown exactly as supplied in feedback.json. No star rating or
// AggregateRating markup is added: these comments are not verified store ratings.
const initials=(name:string)=>name.split(/\s+/).map(part=>part[0]).join('').slice(0,2).toUpperCase();
const first=feedback.slice(0,3),rest=feedback.slice(3);
---
<section class="section community-feedback" aria-labelledby="community-feedback-title">
 <div class="section-head">
  <h2 id="community-feedback-title">What GlowTV users say</h2>
  <p class="feedback-context">Reviews collected from GlowTV users across social media platforms.</p>
 </div>
 <ul class="feedback-grid">{first.map(review=><li class="feedback-card"><figure><blockquote><p>{review.quote}</p></blockquote><figcaption><span class="feedback-avatar" aria-hidden="true">{initials(review.name)}</span><span class="feedback-name">{review.name}{review.excerpt&&<span class="feedback-excerpt">Excerpt</span>}</span></figcaption></figure></li>)}</ul>
 {rest.length>0&&<details class="feedback-more"><summary>Read {rest.length} more comments</summary><ul class="feedback-grid">{rest.map(review=><li class="feedback-card"><figure><blockquote><p>{review.quote}</p></blockquote><figcaption><span class="feedback-avatar" aria-hidden="true">{initials(review.name)}</span><span class="feedback-name">{review.name}{review.excerpt&&<span class="feedback-excerpt">Excerpt</span>}</span></figcaption></figure></li>)}</ul></details>}
 <div class="feedback-actions">
  <a class="button secondary" href="https://github.com/nhshajib/NodeCast/issues/new?title=GlowTV%20feedback">Share your experience <Icon name="arrow-right" size={18}/></a>
  <a class="button secondary" href="https://github.com/nhshajib/NodeCast/issues/new?labels=enhancement&amp;title=Feature%20request">Request a feature <Icon name="plus" size={18}/></a>
 </div>
</section>
<style>
 .feedback-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:0;padding:0;list-style:none}
 .feedback-card{min-width:0;margin:0;display:flex}
 .feedback-card figure{display:flex;flex-direction:column;justify-content:space-between;gap:20px;margin:0;width:100%;padding:24px;border:1px solid var(--line);border-radius:var(--radius-lg,20px);background:var(--surface)}
 .feedback-card blockquote{margin:0;position:relative}
 .feedback-card blockquote::before{content:"\201C";display:block;height:28px;font-size:56px;line-height:1;font-weight:600;color:var(--green)}
 .feedback-card blockquote p{margin:0;font-size:16px;line-height:1.65;color:var(--ink);overflow-wrap:anywhere}
 .feedback-card figcaption{display:flex;align-items:center;gap:12px;font-size:15px;font-weight:600;color:var(--ink)}
 .feedback-avatar{display:grid;place-items:center;flex:0 0 40px;width:40px;height:40px;border-radius:50%;background:var(--mint);color:var(--deep);font-size:14px;font-weight:600;letter-spacing:0}
 .feedback-name{display:flex;flex-direction:column;line-height:1.3}
 .feedback-excerpt{font-size:13px;font-weight:500;color:var(--muted)}
 .feedback-more{margin-top:16px}
 .feedback-more summary{display:inline-flex;align-items:center;min-height:48px;cursor:pointer;color:var(--link);font-size:16px;font-weight:600}
 .feedback-more[open] summary{margin-bottom:8px}
 .feedback-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
 @media(max-width:900px){.feedback-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:640px){
  .feedback-grid{grid-template-columns:1fr;gap:12px}
  .feedback-card figure{padding:16px;gap:16px;border:0;border-radius:var(--cell-radius,12px);background:var(--ios-cell,var(--surface))}
  .feedback-card blockquote::before{height:20px;font-size:40px}
  .feedback-card blockquote p{font-size:16px;line-height:1.5}
  .feedback-actions{flex-direction:column;align-items:stretch;gap:8px;margin-top:20px}
  .feedback-actions .button{width:100%}
 }
</style>
