---
import feedback from '../data/feedback.json';
import Icon from './Icon.astro';
---
<section class="content community-feedback" aria-labelledby="community-feedback-title">
 <p class="eyebrow">Community feedback</p>
 <h2 id="community-feedback-title">Experiences shared with us</h2>
 <p class="feedback-context">Feedback provided by the GlowTV team, across app versions. Some comments are excerpted. GlowTV is a player only; channels, picture quality and buffering depend on your provider, stream and connection.</p>
 <ul class="feedback-list">{feedback.slice(0,3).map(review=><li><figure><blockquote><p>“{review.quote}”</p></blockquote><figcaption>{review.name}{review.excerpt&&<span> · Excerpt</span>}</figcaption></figure></li>)}</ul>
 <details class="feedback-more"><summary>Read {feedback.length-3} more comments</summary><ul class="feedback-list">{feedback.slice(3).map(review=><li><figure><blockquote><p>“{review.quote}”</p></blockquote><figcaption>{review.name}{review.excerpt&&<span> · Excerpt</span>}</figcaption></figure></li>)}</ul></details>
 <div class="feedback-actions"><a class="text-link" href="https://github.com/nhshajib/NodeCast/issues/new?title=GlowTV%20feedback">Share your experience <Icon name="arrow-right" size={16}/></a><a class="text-link" href="https://github.com/nhshajib/NodeCast/issues/new?labels=enhancement&amp;title=Feature%20request">Request a feature <Icon name="plus" size={16}/></a></div>
</section>
<style>
 .community-feedback{padding-top:32px;padding-bottom:32px}
 .community-feedback h2{margin-top:0}
 .feedback-context{font-size:14px;line-height:1.65;margin:12px 0 24px;color:var(--muted)}
 .feedback-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:0;padding:0!important;list-style:none;color:var(--ink)}
 .feedback-list li{min-width:0;margin:0;padding-top:16px;border-top:1px solid var(--line)}
 .feedback-list figure,.feedback-list blockquote{margin:0}
 .feedback-list blockquote p{font-size:15px;line-height:1.7;color:var(--ink);overflow-wrap:anywhere}
 .feedback-list figcaption{margin-top:12px;font-size:14px;font-weight:600;color:var(--ink)}
 .feedback-list figcaption span{font-weight:400;color:var(--muted)}
 .feedback-more{margin-top:24px;border-top:1px solid var(--line)}
 .feedback-more summary{min-height:48px;padding:12px 0;cursor:pointer;color:var(--link);font-size:15px;font-weight:600}
 .feedback-more .feedback-list{padding-top:8px!important}
 .feedback-actions{display:flex;flex-wrap:wrap;gap:8px 24px;margin-top:24px}
 @media(max-width:760px){.feedback-list{grid-template-columns:1fr;gap:20px}.community-feedback{padding-top:24px}.feedback-actions{flex-direction:column;align-items:flex-start;gap:4px}.feedback-context{font-size:14px}}
</style>
