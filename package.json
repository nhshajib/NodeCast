{
  "name": "nodecast-iphone",
  "description": "Standalone IPTV player for iPhone, Android mobile and Android TV",
  "license": "GPL-3.0-only",
  "version": "0.6.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.17",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-intent-launcher": "~58.0.3",
    "expo-libvlc-player": "58.0.0",
    "expo-linear-gradient": "~58.0.3",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.12",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "start:go": "expo start --go",
    "start:tunnel": "expo start --go --tunnel",
    "start:dev": "expo start --dev-client",
    "start:dev:tunnel": "expo start --dev-client --tunnel",
    "build:dev": "npx eas-cli@latest build --platform ios --profile development",
    "build:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "build:production": "npx eas-cli@latest build --platform ios --profile production",
    "build:android:mobile": "node scripts/run-android.cjs mobile",
    "build:android:tv": "node scripts/run-android.cjs tv",
    "postinstall": "node scripts/patch-android-vlc.cjs"
  },
  "private": true
}
