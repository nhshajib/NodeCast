{
  "name": "nodecast-iphone",
  "description": "Standalone iPhone IPTV player with Expo development and production builds",
  "license": "GPL-3.0-only",
  "version": "0.2.2",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.17",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-linear-gradient": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "start:go": "expo start --go",
    "start:tunnel": "expo start --go --tunnel",
    "start:dev": "expo start --dev-client",
    "start:dev:tunnel": "expo start --dev-client --tunnel",
    "build:dev": "npx eas-cli@latest build --platform ios --profile development",
    "build:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "build:production": "npx eas-cli@latest build --platform ios --profile production"
  },
  "private": true
}
